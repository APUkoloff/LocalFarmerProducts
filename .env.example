# Database
DB_ENGINE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fresh_market
DB_USER=fresh_user
DB_PASSWORD=fresh_pass

# Django
DJANGO_SECRET_KEY=change-me-in-production
